{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Przepis do Mojej kuchni",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "category", "servings", "ingredients", "preparation"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "\\S", "maxLength": 90 },
    "category": { "type": "string", "pattern": "\\S", "maxLength": 70 },
    "servings": { "type": "integer", "minimum": 1, "maximum": 100 },
    "description": { "type": "string", "maxLength": 280 },
    "ingredients": { "$ref": "#/$defs/ingredients" },
    "preparation": {
      "allOf": [{ "$ref": "#/$defs/preparation" }],
      "minItems": 1
    },
    "components": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/component" }
    },
    "notes": { "$ref": "#/$defs/notes" }
  },
  "$defs": {
    "ingredients": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quantity", "unit"],
        "properties": {
          "name": { "type": "string", "pattern": "\\S", "maxLength": 200 },
          "quantity": {
            "oneOf": [
              { "type": "number", "minimum": 0 },
              { "type": "string", "maxLength": 40 },
              { "type": "null" }
            ]
          },
          "unit": { "type": "string", "maxLength": 30 }
        }
      }
    },
    "preparation": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "pattern": "\\S", "maxLength": 4000 }
    },
    "notes": { "type": "string", "maxLength": 4000 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ingredients", "preparation"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S", "maxLength": 60 },
        "ingredients": { "$ref": "#/$defs/ingredients" },
        "preparation": { "$ref": "#/$defs/preparation" },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "anyOf": [
        { "properties": { "ingredients": { "minItems": 1 } } },
        { "properties": { "preparation": { "minItems": 1 } } }
      ]
    }
  }
}
